# ============================================================
# 发证方 (issuer) sample 专用配置
# 发证方身份需已在平台完成发证方注册（准入流程在 sample 之外完成），
# sample 直接用发证方自己的私钥登录平台。
# 签发/撤销/建模板的链上交易由平台中转上链（SDK 只做本地签名），
# 因此本 sample 只依赖 VC 平台 HTTP 接口，不直连链节点。
#
# 身份私钥只在本文件（.env.issuer 已被 .gitignore 忽略），
# 不要提交到 git；accessToken 不落盘，每次命令重新登录。
# ============================================================

# ---- 必填 ----

# 发证方自己的星火编码私钥（其 BID 已在平台注册为发证方）。
VC_ISSUER_PRIVATE_KEY=

# 平台登录主机根地址（BID 挑战登录所在主机），不要包含 /server。
VC_PLATFORM_BASE_URL=

# 发证方门户主机根地址（业务接口 /api/omp/... 与令牌交换所在主机）。
VC_CREDENTIAL_BASE_URL=
