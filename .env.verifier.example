# ============================================================
# 本地验证方 sample 专用配置
# 直连节点用于 IAM/TDS 信任查询和 DDO 合约 queryBid（读取 issuer DID 文档与公钥，不经解析服务）。
# VC_REVOCATION_BASE_URL 是发证方平台地址，撤销状态查询该地址下的 /api/cred/vc/revoked/{id}。
# 不需要私钥、issuer 公钥、BOP、解析服务或平台验证 URL。
# 请使用受信任的 HTTPS 地址；SDK 默认保持 TLS 证书校验。
# ============================================================

BID_DIRECT_NODE_URL=
VC_REVOCATION_BASE_URL=