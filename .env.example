# ============================================================
# BID BOP sample
# 节点 URL 写在 sample/config.ts；合约地址由 SDK 内部固定
# ============================================================

# 写链源账户的星火编码私钥。
BID_SOURCE_PRIVATE_KEY=

# BOP 调用凭据。没有 API Secret 时保持空值。
BID_BOP_API_KEY=
BID_BOP_API_SECRET=

# 写链后等待解析服务建立索引的时间，单位毫秒。
BID_RESOLUTION_WAIT_MS=


# ============================================================
# VC 发证方与验证方（issuer/verifier）专用
# 持证方（holder）请使用 .env.holder，不需要配置开放平台
# ============================================================

# 发证方的星火编码私钥。
VC_ISSUER_PRIVATE_KEY=

# 可选：用于核对私钥推导出的 BID。
VC_EXPECTED_ISSUER_BID=

# 发证审核参数。
VC_ISSUE_STATUS=
VC_ISSUE_IS_SEL=
VC_ISSUE_REASON=
VC_ISSUE_AUDIT_CONTENT=


# ============================================================
# VC 主动调用平台验证服务时使用
# 验证服务 URL 写在 sample/config.ts
# ============================================================

VC_REMOTE_VERIFY_API_KEY=

# 独立撤销历史凭证时使用；同一次完整流程优先使用动态结果。
VC_REVOCATION_CREDENTIAL_BID=
VC_REVOCATION_TX_HASH=
VC_REVOCATION_BLOB=
VC_REVOCATION_AUDIT_NODE_ADDRESS=
VC_REVOCATION_REMARK=
